{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "src/*": [
        "src/*"
      ],
      "@app/*": [
        "src/app/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@screens/*": [
        "src/app/screens/*"
      ],
      "@store/*": [
        "src/app/store/*"
      ],
      "@theme/*": [
        "src/app/theme/*"
      ]
    },
    "types": [
      "react",
      "react-native"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "allowJs": true,
    "lib": [
      "DOM",
      "ESNext"
    ],
    "noEmit": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "react-app-env.d.ts" // Include the declaration file
  ],
  "exclude": [
    "node_modules"
  ]
}